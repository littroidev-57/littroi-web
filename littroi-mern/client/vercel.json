{
  "redirects": [
    {
      "source": "/wp-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/wp-sitemap(.*)",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/about-us-2(.*)",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/about-2(.*)",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/services-2(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact-us-2(.*)",
      "destination": "/contact-us",
      "permanent": true
    },
    {
      "source": "/contact-2(.*)",
      "destination": "/contact-us",
      "permanent": true
    },
    {
      "source": "/home-2(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/boost-your-business-with-effective-digital-strategies(.*)",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/why-cro-is-key-to-maximizing-your-content-roi(.*)",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about-us",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/contact-us",
      "permanent": true
    },
    {
      "source": "/testimonial",
      "destination": "/testimonials",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/legal-policies",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/legal-policies",
      "permanent": true
    },
    {
      "source": "/terms-and-conditions",
      "destination": "/legal-policies",
      "permanent": true
    },
    {
      "source": "/feed(.*)",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/wp-content/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/wp-includes/(.*)",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
